# ─── SmartHR backend ─────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# PostgreSQL 16
DATABASE_URL="postgresql://smarthr:smarthr@localhost:5432/smarthr?schema=public"

# 48+ random characters each:  openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-48-characters"
PLATFORM_JWT_SECRET="change-me-to-a-different-long-random-string-48-chars"

# The web console address. Used for links in emails and for the cookie domain.
APP_URL="http://localhost:3000"
# Set true behind HTTPS (production). Cookies are then Secure.
COOKIE_SECURE=false

# Where uploaded files (logos, documents, imports, payslip PDFs) are stored.
UPLOAD_DIR="./storage"

# First platform admin, created by `npm run db:seed` if none exists.
PLATFORM_ADMIN_EMAIL="admin@lumiai.lk"
PLATFORM_ADMIN_PASSWORD="ChangeMe!2026"

# Email (optional). Leave SMTP_HOST empty to log emails to the console instead.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SmartHR <no-reply@lumiai.lk>"

# Push notifications through Firebase Cloud Messaging (optional).
# Path to the Firebase service-account JSON. Leave empty to disable push.
FCM_SERVICE_ACCOUNT_FILE=""
